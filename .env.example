# Application Configuration
# development | production | test
NODE_ENV=development
# Port the app listens on. Render sets this automatically; the app also
# falls back to 3000 for local development.
PORT=3000

# Database Configuration
# POSTGRES_* are only used by docker-compose.yml to provision the local
# "db" container; the app itself only reads DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=grocademy

DATABASE_URL="postgresql://postgres:replace-with-a-strong-password@db:5432/grocademy?schema=public"

# JWT Configuration
JWT_SECRET=replace-with-a-long-random-secret

# Frontend/OAuth redirect base URL - where the browser is sent back to
# after a successful Google OAuth login (see src/backend/auth/auth.controller.ts).
FRONTEND_URL=http://127.0.0.1:3000

# Google OAuth Configuration
# Callback path is fixed by the app at /auth/google/callback - in
# production this must be:
#   https://<your-render-domain>/auth/google/callback
# and must be registered as an authorized redirect URI in the Google
# Cloud OAuth client.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://127.0.0.1:3000/auth/google/callback

# Google Cloud Storage Configuration (used for uploaded course thumbnails,
# module PDFs and videos)
GOOGLE_CLOUD_PROJECT_ID=replace-with-your-gcp-project-id
GOOGLE_CLOUD_KEYFILE=path/to/your-service-account-key.json
GOOGLE_CLOUD_STORAGE_BUCKET=replace-with-your-gcs-bucket-name
